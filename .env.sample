STACK_NAME=virtualizarr-data-pipelines
STAGE="dev"
GARBAGE_COLLECTION_FREQUENCY=2

# Forward SQS consumer. Leave unset to default: enabled normally, but disabled
# automatically when BACKFILL_ENABLED=true (so the backfill bootstraps main first).
# After the backfill promotes, set FORWARD_QUEUE_ENABLED=true and redeploy.
# FORWARD_QUEUE_ENABLED=false

STAGE=dev
ACCOUNT_ID=
ACCOUNT_REGION=
# Garbage collection runs in an AWS Batch cluster inside a VPC.
# Enabling it requires BOTH of the following, and `cdk synth` will then
# perform a VPC lookup that needs real AWS credentials for ACCOUNT_ID.
# GARBAGE_COLLECTION_FREQUENCY=2
# VPC_ID=vpc-0123456789abcdef0
